    {
      "condition": "[parameters('enableResourceLocks')]",
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities/providers/locks",
      "apiVersion": "2017-04-01",
      "name": "[format('{0}/Microsoft.Authorization/{1}-lock', parameters('managedIdentityName'), parameters('managedIdentityName'))]",
