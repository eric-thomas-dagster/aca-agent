        "addressPrefix": "[parameters('subnetPrefix')]",
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', format('{0}-nsg', parameters('vnetName')))]"
        },
        "natGateway": "[if(parameters('enableNatGateway'), createObject('id', resourceId('Microsoft.Network/natGateways', format('{0}-natgw', parameters('vnetName')))), null())]",
        "delegations": [
          {
            "name": "Microsoft.App.environments",
            "properties": {
              "serviceName": "Microsoft.App/environments"
            }
          }
