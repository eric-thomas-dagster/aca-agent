                  "value": "[join(concat(createArray(format('{0}:DAGSTER_CLOUD_API_TOKEN', parameters('dagsterCloudApiTokenSecretName'))), parameters('keyVaultSecretNames'), if(not(equals(parameters('dagsterDeploymentNameSecretName'), '')), createArray(format('{0}:DAGSTER_CLOUD_DEPLOYMENT_NAME', parameters('dagsterDeploymentNameSecretName'))), createArray()), if(not(equals(parameters('dagsterOrgIdSecretName'), '')), createArray(format('{0}:DAGSTER_CLOUD_ORG_ID', parameters('dagsterOrgIdSecretName'))), createArray())), ',')]"
                },
                {
                  "name": "DAGSTER_CLOUD_DEPLOYMENT_NAME",
                  "value": "[parameters('dagsterDeploymentName')]"
                },
                {
                  "name": "DAGSTER_CLOUD_ORG_ID",
                  "value": "[parameters('dagsterOrgId')]"
                },
                {
                  "name": "AGENT_METRICS_ENABLED",
                  "value": "[toLower(string(parameters('agentMetricsEnabled')))]"
                },
                {
                  "name": "CODE_SERVER_METRICS_ENABLED",
                  "value": "[toLower(string(parameters('codeServerMetricsEnabled')))]"
                },
                {
                  "name": "AZURE_SUBSCRIPTION_ID",
                  "value": "[subscription().subscriptionId]"
                },
                {
                  "name": "AGENT_RESOURCE_GROUP",
                  "value": "[resourceGroup().name]"
                },
                {
                  "name": "ENVIRONMENT_NAME",
                  "value": "[parameters('environmentName')]"
                },
                {
                  "name": "AZURE_LOCATION",
                  "value": "[parameters('location')]"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), '2018-11-30').clientId]"
                },
                {
                  "name": "AZURE_TENANT_ID",
                  "value": "[subscription().tenantId]"
                },
                {
                  "name": "CODE_SERVER_IDENTITY_ID",
                  "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName'))]"
                },
                {
                  "name": "CODE_SERVER_CPU",
                  "value": "[parameters('codeServerCpu')]"
                },
                {
                  "name": "CODE_SERVER_MEMORY",
                  "value": "[parameters('codeServerMemory')]"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('numReplicas')]",
            "maxReplicas": "[parameters('numReplicas')]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), parameters('dagsterCloudApiTokenSecretName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), parameters('dagsterDeploymentNameSecretName'))]",
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', parameters('keyVaultName'), parameters('dagsterOrgIdSecretName'))]"
      ]
    },
    {
      "copy": {
        "name": "roleAssigns",
        "count": "[length(variables('assignments'))]"
      },
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2020-04-01-preview",
      "name": "[guid(subscription().id, resourceGroup().name, parameters('managedIdentityName'), string(copyIndex()))]",
      "properties": {
        "roleDefinitionId": "[variables('assignments')[copyIndex()].roleDefinitionId]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), '2018-11-30').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2020-04-01-preview",
      "name": "[guid(subscription().id, resourceGroup().name, parameters('managedIdentityName'), variables('effectiveAgentRoleId'))]",
      "properties": {
        "roleDefinitionId": "[variables('effectiveAgentRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')), '2018-11-30').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/providers/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "name": "[format('{0}/Microsoft.Insights/kv-audit', parameters('keyVaultName'))]",
      "properties": {
        "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]",
        "logs": [
          { "category": "AuditEvent", "enabled": true }
        ],
        "metrics": [
          { "category": "AllMetrics", "enabled": true }
        ]
      },
      "dependsOn": [
