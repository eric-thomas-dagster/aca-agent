        "[resourceId('Microsoft.Network/networkSecurityGroups', format('{0}-nsg', parameters('vnetName')))]",
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2022-03-01",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName')))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "configuration": {
          "activeRevisionsMode": "[if(parameters('enableZeroDowntimeDeploys'), 'Multiple', 'Single')]",
          "secrets": []
        },
        "template": {
          "containers": [
            {
              "name": "dagster-agent",
              "image": "[parameters('agentImage')]",
              "resources": {
                "cpu": "[json(parameters('agentCpu'))]",
                "memory": "[parameters('agentMemory')]"
              },
              "env": [
                {
                  "name": "AGENT_NAME",
                  "value": "[parameters('containerAppName')]"
                },
                {
                  "name": "DAGSTER_CLOUD_URL",
                  "value": "[format('https://{0}', variables('dagsterBaseDomain'))]"
                },
                {
                  "name": "DAGSTER_CLOUD_BASE_DOMAIN",
                  "value": "[variables('dagsterBaseDomain')]"
                },
                {
                  "name": "KEY_VAULT_URI",
                  "value": "[format('https://{0}.vault.azure.net/', parameters('keyVaultName'))]"
                },
                {
