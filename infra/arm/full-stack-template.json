        "notes": "Locked to prevent accidental deletion of the Dagster agent managed identity."
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('managedIdentityName'))]"
      ]
    },
    {
      "condition": "[parameters('enableAlerts')]",
      "type": "Microsoft.Insights/actionGroups",
      "apiVersion": "2023-01-01",
      "name": "dagster-alerts",
      "location": "global",
      "properties": {
        "groupShortName": "dagster",
        "enabled": true,
        "emailReceivers": "[if(not(empty(parameters('alertEmailAddress'))), createArray(createObject('name', 'email-receiver', 'emailAddress', parameters('alertEmailAddress'), 'useCommonAlertSchema', true())), createArray())]"
      }
    },
    {
      "condition": "[parameters('enableAlerts')]",
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "dagster-agent-restarts",
      "location": "global",
      "properties": {
        "description": "Dagster agent container has restarted.",
        "severity": 2,
        "enabled": true,
        "scopes": [ "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]" ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT5M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "name": "RestartCount",
              "metricName": "RestartCount",
              "operator": "GreaterThan",
              "threshold": 0,
              "timeAggregation": "Total",
              "criterionType": "StaticThresholdCriterion"
            }
          ]
        },
        "actions": [ { "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', 'dagster-alerts')]" } ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', 'dagster-alerts')]",
        "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]"
      ]
    },
    {
      "condition": "[parameters('enableAlerts')]",
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "dagster-agent-not-running",
      "location": "global",
      "properties": {
        "description": "Dagster agent has zero running replicas.",
        "severity": 1,
        "enabled": true,
        "scopes": [ "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]" ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "name": "RunningReplicas",
              "metricName": "RunningReplicaCount",
              "operator": "LessThan",
              "threshold": 1,
              "timeAggregation": "Average",
              "criterionType": "StaticThresholdCriterion"
            }
          ]
        },
        "actions": [ { "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', 'dagster-alerts')]" } ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', 'dagster-alerts')]",
        "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]"
      ]
    },
    {
      "condition": "[parameters('enableAlerts')]",
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "dagster-keyvault-failures",
      "location": "global",
      "properties": {
        "description": "Key Vault API requests are failing — agent may be unable to fetch secrets.",
        "severity": 2,
        "enabled": true,
        "scopes": [ "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]" ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT15M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "name": "ServiceApiResult",
              "metricName": "ServiceApiResult",
              "operator": "GreaterThan",
              "threshold": 0,
              "timeAggregation": "Total",
              "criterionType": "StaticThresholdCriterion",
              "dimensions": [
                { "name": "StatusCode", "operator": "Include", "values": [ "4xx", "5xx" ] }
              ]
            }
          ]
        },
        "actions": [ { "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', 'dagster-alerts')]" } ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', 'dagster-alerts')]",
        "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
      ]
    }
  ],
  "outputs": {
